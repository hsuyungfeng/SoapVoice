# SoapVoice 專案環境變數配置

# CUDA 配置
CUDA_PATH=/usr/local/cuda
CUDA_VERSION=12.2

# Python 配置
PYTHON_VERSION=3.11
PYTHON_PATH=/usr/bin/python3

# 專案配置
PROJECT_NAME=SoapVoice
ENVIRONMENT=development

# API 配置
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:7b

# CPU 離線模式配置 (llama.cpp)
USE_LLAMA_CPP=true
MODELS_DIR=/home/hsu/Desktop/SoapVoice/models
LLAMA_MODEL_PATH=models/gemma-4-E4B-it-Q4_K_M.gguf
LLAMA_THREADS=16
LLAMA_N_CTX=4096

# ASR 配置
# ASR_MODEL=large-v3
# ASR_BACKEND=whisper
ASR_MODEL=Qwen/Qwen3-ASR-0.6B
ASR_BACKEND=qwen3asr
ASR_COMPUTE_TYPE=int8

# GPU 加速配置（Faster-Whisper）
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16

# LLM GPU 層數配置（llama.cpp）
# -1 = 全部卸載至 GPU（Gemma 4 E4B 5.1GB 可完全放入 8GB+ VRAM）
# 若 VRAM < 6GB 改為 18（卸載一半層數）
LLAMA_N_GPU_LAYERS=-1

# 區域網路 API 配置
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# API Key（隨機生成，區網客戶端需使用此值）
DEFAULT_API_KEY=sv-lan-7a8b9c0d1e2f3g4h5i6j7k8l9m0n1o2p
