# SoapVoice 專案環境變數配置

# CUDA 配置
CUDA_PATH=/usr/local/cuda
CUDA_VERSION=12.2

# Python 配置
PYTHON_VERSION=3.11
PYTHON_PATH=/usr/bin/python3

# 專案配置
PROJECT_NAME=SoapVoice
ENVIRONMENT=development

# API 配置
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:7b

# CPU 離線模式配置 (llama.cpp)
USE_LLAMA_CPP=true
MODELS_DIR=/home/hsu/Desktop/SoapVoice/models
LLAMA_MODEL_PATH=models/gemma-4-E4B-it-Q4_K_M.gguf
LLAMA_THREADS=16
LLAMA_N_CTX=4096

# ASR 配置
# ASR_MODEL=large-v3
# ASR_BACKEND=whisper
ASR_MODEL=Qwen/Qwen3-ASR-0.6B
ASR_BACKEND=qwen3asr
ASR_COMPUTE_TYPE=int8
